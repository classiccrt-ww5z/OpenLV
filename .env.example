DB_HOST=db
DB_DATABASE=neoncodebase
DB_USER=neoncodebase
DB_PASSWORD=change-me

DB_CHARSET=utf8mb4

# Second factor for the admin panel. Users must supply their own password AND this
# value at /admin/login. Generate with: openssl rand -hex 24
ADMIN_PASSWORD=change-me

# Signs the "remember me" cookie (HMAC-SHA256). If this is unset the feature is
# disabled entirely rather than falling back to a well-known key. Rotating it
# invalidates all existing remember cookies.
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=

# Shared secret for the transcoding worker. There is no default; the worker refuses
# to run without it. Generate with: openssl rand -hex 24
CONVERTER_KEY=

# Set to 1 to render full PDO error messages (SQL + bound parameters) to the browser.
# Never enable on a public site.
APP_DEBUG=0

# Set to 1 when running behind a TLS-terminating proxy so session cookies get the
# Secure attribute even though the back end sees plain HTTP.
SESSION_COOKIE_SECURE=0

# Optional: Google reCAPTCHA v2/v3 keys. When RECAPTCHA_SECRET is set, captcha-protected
# forms (login, register, forgot password, admin panel, edit video) are verified against
# Google. When it is empty a server-side rate limit is used instead -- see THROTTLE_*.
RECAPTCHA_SECRET=
RECAPTCHA_SITE_KEY=

# Server-side throttle used when RECAPTCHA_SECRET is not configured.
# check_captcha() denies once an IP exceeds THROTTLE_MAX_FAILURES recorded failures
# within THROTTLE_WINDOW_MINUTES.
THROTTLE_WINDOW_MINUTES=30
THROTTLE_MAX_FAILURES=20

# Optional SMTP. PHPMailer reads these for activation, password reset and strike mails.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=tls
MAIL_FROM=